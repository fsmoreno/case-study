# OPCIONAL. O docker-compose.yml já traz padrões de desenvolvimento e `docker compose up` funciona sem este arquivo.
# Para mudar os valores, copie para .env (ignorado pelo Git): o Compose o lê automaticamente.
# Estes valores são APENAS para desenvolvimento local; no Kubernetes os segredos vêm do Secrets Manager (via ESO).
DB_NAME=estuda
DB_USER=estuda
DB_PASSWORD=estuda-dev
MYSQL_ROOT_PASSWORD=root-dev
